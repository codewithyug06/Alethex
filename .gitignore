# =============================================================================
# ALETHEX .gitignore
# =============================================================================

# Ignore all markdown notes, internal reports, and drafts except root README.md
**/*.md
!/README.md

# Specification PDFs & raw text extractions
*.pdf
extracted_spec.txt
**/paper/
paper/
**/results/
results/

# Large ML model checkpoints & weights (>100MB breaks GitHub push limit)
**/models/
models/
*.onnx
*.safetensors
*.bin
*.pt
*.pth
*.h5

# Large preprocessed and raw datasets
**/dataset/
dataset/
*.jsonl
*.csv

# Python caches, testing & build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
output/
**/output/
scratch/
**/scratch/
test_output*/
logs/
*.log

# Shell typo / stray artifacts
45%
int]
Optional[Path]

# Environment & local configurations
.env
.venv/
venv/
ENV/
*.local

# Operating System & IDE junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
